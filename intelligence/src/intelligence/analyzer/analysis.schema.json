{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fatflowers.github.io/schemas/intelligence/analysis.schema.json",
  "title": "Personal Intelligence Analysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "key_change",
    "why_it_matters",
    "company_impact",
    "importance",
    "confidence",
    "topics",
    "watch_next",
    "evidence"
  ],
  "properties": {
    "summary": { "type": "string", "minLength": 1 },
    "key_change": { "type": "string", "minLength": 1 },
    "why_it_matters": { "type": "string", "minLength": 1 },
    "company_impact": { "type": "string", "minLength": 1 },
    "importance": { "type": "integer", "minimum": 1, "maximum": 5 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "topics": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "watch_next": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "claim"],
        "properties": {
          "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
          "claim": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
