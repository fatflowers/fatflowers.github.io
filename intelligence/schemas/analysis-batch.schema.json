{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analyses"
  ],
  "properties": {
    "analyses": {
      "type": "array",
      "items": {
        "title": "Personal Intelligence Analysis",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "headline",
          "summary",
          "key_change",
          "why_it_matters",
          "company_impact",
          "importance",
          "confidence",
          "topics",
          "watch_next",
          "evidence",
          "item_id",
          "content_revision"
        ],
        "properties": {
          "headline": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "pattern": "^[^\\r\\n]+$",
            "description": "简洁中文事件标题：主体与具体变化，勿重复摘要，最多 60 字。"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "key_change": {
            "type": "string",
            "minLength": 1
          },
          "why_it_matters": {
            "type": "string",
            "minLength": 1
          },
          "company_impact": {
            "type": "string",
            "minLength": 1
          },
          "importance": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "watch_next": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "url",
                "claim"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "pattern": "^https?://"
                },
                "claim": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "item_id": {
            "type": "string",
            "minLength": 1
          },
          "content_revision": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "maxItems": 100
    }
  }
}
